# Copy this file to .env.local and fill in the values from cPanel > Email Accounts
# for the noreply@jalour.com mailbox. .env.local is gitignored and must never be committed.

# Usually mail.jalour.com — check cPanel > Email Accounts > Connect Devices for the exact host
SMTP_HOST=

# 465 (SSL) or 587 (TLS) — cPanel's "Connect Devices" page shows both
SMTP_PORT=465

# Full mailbox address, e.g. noreply@jalour.com
SMTP_USER=

# The mailbox password set when the account was created in cPanel
SMTP_PASS=

# Optional — display name shown as the sender
SMTP_FROM_NAME=JALOUR Website

# MySQL database created in cPanel > MySQL Databases (stores investor applications)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Password for the /admin dashboard where staff approve/decline investor applications.
# Pick a strong, unique password — anyone with it can view applicant data and issue access codes.
ADMIN_PASSWORD=

# Random secret used to sign admin/investor session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this constant once set — changing it logs everyone out.
SESSION_SECRET=
